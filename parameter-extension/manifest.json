{
  "manifest_version": 3,
  "name": "EC-FIX-IT",
  "version": "2.4.2",
  "description": "Test SIP/MIP date and language parameters, check MRAID and size limits, fix HTML, compress creatives and collect reviews.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "clipboardWrite",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "file:///*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://playable.applovindemo.com/*",
    "https://raw.githubusercontent.com/franciaemilhplgamedesign-tech/parameter-fixer-ext/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "auto-mraid.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://playable.applovindemo.com/*",
        "file:///*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "preview-parameter-runtime.js",
        "preview-parameter-autoload.js",
        "applovin-frame-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "ec-logo-w.png",
    "32": "ec-logo-w.png",
    "48": "ec-logo-w.png",
    "128": "ec-logo-w.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EC-FIX-IT",
    "default_icon": {
      "16": "ec-logo-w.png",
      "32": "ec-logo-w.png",
      "48": "ec-logo-w.png",
      "128": "ec-logo-w.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self';"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
